/.sisyphus

# Build output
/build/**

# Native addon binaries
*.node

# Object files
*.o

# Static archives
*.a

# Dependency files
*.d

# NPM packages
node_modules/

# Test data blobs (root + test/)
/test*.bin
/test/test*.bin

# Old bench script location (moved to test/bench/ in 2026-06 refresh)
/test/bench-js/

# Bench suite output (generated by test/bench/run-all.js)
/test/results/

# Test output fixtures
/test/testout*.par2
/test/testout*.vol*
/test/refout*.par2
/test/refout*.vol*

# Root-level test binaries (executable)
/compute_mu
/compute_mu2
/test_barrett
/test_barrett2
/test_barrett3
/test_gf32_minimal
/verify_naive

# C++ benchmark test binaries (already built)
/gf64/test/test
/gf64/test/test_all

# xor_depends helper tool
/xor_depends/

# OhMyOpenCode internal state (planning, evidence, boulder)
/.omo/
/.planning/

# V8 profiler output (from node --prof runs, e.g. kernel parity test)
/isolate-*.v8.log

# Built gf64 test/bench binaries (make output)
gf64/test/test_*
gf64/test/bench_*
!gf64/test/*.c

# PAR3_PROFILE=1 dump
.par3-profile-dump.txt

# Local Zen4 bench re-run output (test/bench/par3-create-bench.js driver scripts)
# — one dated folder per run; the 2026-08-18 README numbers were produced
# from bench-reports/zen4-rerun-2026-08-18/ using:
#   - 3-run median protocol (BENCHMARKING.md §3)
#   - AVX-512 downclock protocol (BENCHMARKING.md §5.2, §7.5, §7.7; 30 s
#     cooldown rule per workload class is documented in
#     parparpar-bench-and-fork skill, "Bench-runner discipline" section)
# The /bench-reports/ folder is local-only and is NOT committed.
/bench-reports/

